---
import Layout from "../../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";

interface Props {
  service: CollectionEntry<"services">;
}

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;
const s = service.data;

// design guidelines §10.5: no price in the schema unless the page itself shows
// a `checked` price — and only for genuinely verified services at all. Multi-tier
// priceTable services (e.g. maternity) skip the single `offers` block rather than
// pick one row arbitrarily.
const jsonLd =
  s.src === "verified"
    ? {
        "@context": "https://schema.org",
        "@type": s.category === "Surgery" ? "MedicalProcedure" : "MedicalTherapy",
        name: s.name,
        description: s.summary,
        ...(s.priceChecked && !s.priceTable ? { offers: { "@type": "Offer", priceCurrency: "PHP" } } : {}),
      }
    : null;
---

<Layout title={s.name} description={s.summary}>
  {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <section class="service-page">
    <a class="back" href="/services">&larr; Back to Services &amp; Specialties</a>

    <p class="eyebrow">{s.category}</p>
    <h1 data-src={s.src}>{s.name}</h1>
    <p class="summary" data-src={s.src}>{s.summary}</p>

    {
      s.priceTable && (
        <div class="tbl-wrap" tabindex="0" role="region" aria-label={`${s.name} package prices`}>
          <table>
            <thead>
              <tr>
                <th>Package</th>
                <th>Small private room</th>
                <th>Semi-private room</th>
              </tr>
            </thead>
            <tbody data-src="verified">
              {s.priceTable.map((row) => (
                <tr>
                  <td>{row.package}</td>
                  <td class="num">{row.smallPrivate}</td>
                  <td class="num">{row.semiPrivate}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }

    {s.priceNote && <p class="price-note">{s.priceNote}</p>}
    {s.priceChecked && (
      <p class="checked">
        Price as published by UASHMC, August 2026 — please confirm before you rely on it.
      </p>
    )}
    {s.contact && <p class="contact">{s.contact}</p>}

    <div class="cta">
      {s.isUrgent ? (
        <a class="btn btn-urgent" href="tel:+63282483460">Call 02 8248 3460</a>
      ) : (
        <a class="btn btn-primary" href="tel:+63282483460">Call to ask · 02 8248 3460</a>
      )}
    </div>
  </section>
</Layout>

<style>
  .service-page { max-width: 760px; margin: 0 auto; padding: var(--space-8) var(--layout-gutter-mobile); }
  .back { display: inline-block; margin-bottom: var(--space-6); color: var(--color-brand-700); text-decoration: none; font-size: var(--font-size-sm); font-weight: 600; }
  .back:hover { text-decoration: underline; }
  .eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--font-size-2xs);
    font-weight: 700; color: var(--color-brand-600); margin: 0 0 var(--space-2);
  }
  h1 { font-size: var(--font-size-3xl); margin-bottom: var(--space-4); }
  .summary { font-size: var(--font-size-lg); color: var(--color-text-body); margin-bottom: var(--space-5); }

  .tbl-wrap { overflow-x: auto; margin-bottom: var(--space-4); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: var(--space-3); border-bottom: 1px solid var(--color-border-default); }
  th { font-size: var(--font-size-sm); color: var(--color-text-muted); }
  .num { font-weight: 600; }

  .price-note, .checked, .contact {
    color: var(--color-text-muted); font-size: var(--font-size-sm); margin: 0 0 var(--space-2);
  }
  .checked { font-style: italic; }

  .cta { margin-top: var(--space-6); }
</style>
