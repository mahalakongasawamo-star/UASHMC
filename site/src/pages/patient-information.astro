---
import Layout from "../layouts/Layout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { getCollection } from "astro:content";
import { HMOS, HMO_PUBLISHED_DATE } from "../data/hmos";

const faq = await getCollection("faq");
const costFaq = faq.filter((f) => f.data.group === "Cost");
const admissionFaq = faq.filter(
  (f) => f.data.group === "Admission" && f.id !== "admission-requirements",
);
---

<Layout
  title="Patient Information"
  description="Admission requirements, HMOs, PhilHealth, billing, medical records and visitor information for United Antipolo Specialists Hospital and Medical Center."
>
  <section class="page-head">
    <p class="eyebrow">Patient Information</p>
    <h1>Everything you need before you arrive</h1>
    <p class="lead">
      Admission, rooms, visiting hours, billing, your rights, and how to get
      your records or a medical certificate.
    </p>
  </section>

  <section class="emergency-card" aria-labelledby="emergency-h">
    <p id="emergency-h" class="emergency-h">
      <span class="sr-only">Immediate action required: </span>Call 911 or go to
      our Emergency Room now if:
    </p>
    <ul>
      <li>There is chest pain or pressure, or difficulty breathing</li>
      <li>There is heavy bleeding that will not stop</li>
      <li>Someone has fainted, is confused, or cannot be woken</li>
      <li>There is sudden weakness, drooping on one side of the face, or slurred speech</li>
      <li>There has been a serious fall, road accident, burn or head injury</li>
      <li>A pregnancy has bleeding, severe pain, or reduced baby movement</li>
    </ul>
    <div class="emergency-acts">
      <a class="btn btn-urgent" href="tel:911">Call 911</a>
      <a class="btn btn-urgent" href="tel:+63282483460">Call UASHMC 02 8248 3460</a>
      <a class="btn btn-ghost" href="/contact">Directions to the ER</a>
    </div>
    <p class="emergency-note">
      <strong>You will not be asked for a deposit first.</strong> Under the
      Anti-Hospital Deposit Law (RA 10932) it is unlawful for any hospital to
      demand a deposit or advance payment before giving basic emergency care.
    </p>
  </section>

  <section class="section">
    <h2>Admission requirements</h2>
    <p class="section-lead">
      What to bring on the day. <span data-src="confirm"
        >Requirements vary by case — the Admitting Office confirms your
        list.</span
      >
    </p>
    <div class="grid2">
      <ul class="doc-list" data-src="verified">
        <li>Your doctor's <b>Admitting Order</b></li>
        <li>One valid government photo ID</li>
        <li>PhilHealth: CF1, CF2 and proof of contributions</li>
        <li>HMO: your card and your <b>Letter of Authorization</b></li>
        <li>Senior citizen or PWD ID, if eligible</li>
        <li>Previous test results, X-rays and your current medicines list</li>
      </ul>
      <div>
        <h3>Rooms and indicative rates</h3>
        <div class="tbl-wrap" tabindex="0" role="region" aria-label="Room types and rates">
          <table>
            <thead>
              <tr><th>Room type</th><th>Per day</th><th>Companion bed</th></tr>
            </thead>
            <tbody data-src="sample">
              <tr><td>Ward</td><td class="num">₱ —</td><td>Shared</td></tr>
              <tr><td>Semi-private</td><td class="num">₱ —</td><td>Yes</td></tr>
              <tr><td>Regular private</td><td class="num">₱ —</td><td>Yes</td></tr>
              <tr><td>Suite</td><td class="num">₱ —</td><td>Yes</td></tr>
            </tbody>
          </table>
        </div>
        <p class="rates-note">
          We do publish package prices for
          <a href="/services">maternity, gallbladder surgery, CT scans and sleep studies</a>.
          For anything else, our Billing Section will give you a written
          estimate before you decide — call
          <a href="tel:+63282483460">02 8248 3460</a> and ask for Billing.
        </p>
      </div>
    </div>
  </section>

  <section class="section" id="hmo">
    <h2>Check your HMO before you come</h2>
    <p class="section-lead">
      Type the name of your HMO instead of reading down a list of twenty.
    </p>
    <p class="section-note">
      Coverage and any authorization are always subject to confirmation by
      UASHMC and your HMO or PhilHealth provider.
    </p>

    <div class="hmo-box">
      <div class="hmo-top">
        <h3>Our HMO partners</h3>
        <span class="asof">
          <span data-src="verified">As published by UASHMC, {HMO_PUBLISHED_DATE}</span>
        </span>
      </div>
      <input id="hq" type="search" placeholder="Type your HMO's name" aria-label="Search HMO partners" />
      <div id="hres" class="hmo-res" tabindex="0" role="region" aria-label="HMO search results" aria-live="polite">
        {
          HMOS.slice(0, 6).map((h) => (
            <div class="hmo-row" data-src="verified">
              <span>{h}</span>
              <span class="badge">Partner</span>
            </div>
          ))
        }
        <div class="hmo-more">Showing 6 of {HMOS.length} — type to find yours.</div>
      </div>
    </div>
  </section>

  <section class="section">
    <h2>PhilHealth, billing and your rights</h2>
    <FaqAccordion items={costFaq} idPrefix="pi-cost" />
  </section>

  <section class="section">
    <h2>Visiting hours and records</h2>
    <FaqAccordion items={admissionFaq} idPrefix="pi-admission" />
  </section>
</Layout>

<script is:inline define:vars={{ hmos: HMOS }}>
  // Same behaviour as the prototype's renderHmo(): case-insensitive substring
  // match against the real 20-partner list, an honest refusal (never a
  // plausible-looking guess) when nothing matches.
  const input = document.getElementById("hq");
  const box = document.getElementById("hres");

  function render(q) {
    q = (q || "").trim().toLowerCase();
    const list = q ? hmos.filter((h) => h.toLowerCase().indexOf(q) > -1) : hmos.slice(0, 6);
    if (!list.length) {
      box.innerHTML =
        '<div class="hmo-empty"><b>We don\'t have "' +
        q.replace(/[<>&]/g, "") +
        '" on our partner list.</b><br>That may mean we are not partnered with them yet, or that our list needs updating. Call <a href="tel:+63282483460">02 8248 3460</a> or Viber 0947 875 4949 and our HMO desk will check for you.</div>';
      return;
    }
    box.innerHTML =
      list
        .map((h) => '<div class="hmo-row" data-src="verified"><span>' + h + '</span><span class="badge">Partner</span></div>')
        .join("") +
      (!q ? '<div class="hmo-more">Showing 6 of ' + hmos.length + " — type to find yours.</div>" : "");
  }

  input.addEventListener("input", () => render(input.value));
</script>

<style>
  .page-head, .section, .emergency-card {
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: var(--space-8) var(--layout-gutter-mobile);
  }
  .page-head { padding-bottom: 0; }
  .eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--font-size-2xs);
    font-weight: 700; color: var(--color-brand-600); margin: 0 0 var(--space-2);
  }
  h1 { font-size: var(--font-size-3xl); margin-bottom: var(--space-4); }
  .lead { font-size: var(--font-size-lg); color: var(--color-text-muted); max-width: 60ch; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  .emergency-card {
    background: var(--color-urgent-tint);
    border: 1px solid var(--color-urgent);
    border-radius: var(--radius-md);
    margin-top: var(--space-6);
  }
  .emergency-h { font-weight: 700; color: var(--color-urgent-ink); font-size: var(--font-size-lg); margin: 0 0 var(--space-3); }
  .emergency-card ul { margin: 0 0 var(--space-4); padding-left: var(--space-5); color: var(--color-urgent-ink); }
  .emergency-card li { margin-bottom: var(--space-1); }
  .emergency-acts { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-bottom: var(--space-4); }
  .emergency-note { color: var(--color-urgent-ink); margin: 0; }

  .section h2 { font-size: var(--font-size-2xl); margin-bottom: var(--space-2); }
  .section-lead { color: var(--color-text-muted); margin-bottom: var(--space-2); max-width: 65ch; }
  .section-note { color: var(--color-text-muted); font-size: var(--font-size-sm); margin-bottom: var(--space-5); }

  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); }
  @media (max-width: 820px) { .grid2 { grid-template-columns: 1fr; } }
  .doc-list { margin: 0; padding-left: var(--space-5); line-height: 1.8; }

  h3 { font-size: var(--font-size-lg); margin-bottom: var(--space-3); }
  .tbl-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: var(--space-3); border-bottom: 1px solid var(--color-border-default); }
  th { font-size: var(--font-size-sm); color: var(--color-text-muted); }
  .rates-note { color: var(--color-text-muted); font-size: var(--font-size-sm); margin-top: var(--space-4); line-height: 1.6; }

  .hmo-box {
    background: var(--color-surface-raised); border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md); padding: var(--space-5); max-width: 560px;
  }
  .hmo-top { display: flex; align-items: baseline; gap: var(--space-3); flex-wrap: wrap; margin-bottom: var(--space-3); }
  .hmo-top h3 { margin: 0; }
  .asof { font-size: var(--font-size-xs); color: var(--color-text-muted); }
  #hq {
    width: 100%; font: inherit; font-size: var(--font-size-base); padding: var(--space-3);
    border: 1px solid var(--color-border-default); border-radius: var(--radius-sm);
    min-height: 44px; margin-bottom: var(--space-3);
  }
  .hmo-res { display: flex; flex-direction: column; gap: var(--space-1); }
  .hmo-row { display: flex; justify-content: space-between; align-items: center; padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border-soft); }
  .badge { font-size: var(--font-size-xs); font-weight: 600; color: var(--color-care-700); background: var(--color-care-tint); padding: 2px var(--space-2); border-radius: var(--radius-pill); }
  .hmo-more { font-size: var(--font-size-sm); color: var(--color-text-muted); padding-top: var(--space-2); }
  .hmo-empty { color: var(--color-text-muted); }
  .hmo-empty a { color: var(--color-brand-700); }
</style>
