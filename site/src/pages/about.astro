---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="About UASHMC"
  description="About United Antipolo Specialists Hospital and Medical Center, a private specialists' hospital at 7 Marcos Highway, Barangay Mambugan, Antipolo City, open since 2025."
>
  <section class="page-head">
    <p class="eyebrow">About UASHMC</p>
    <h1>Getting to know United Antipolo</h1>
    <p class="lead" data-src="verified">
      A private specialists' hospital at 7 Marcos Highway, Barangay Mambugan,
      Antipolo City, Rizal, open since 2025.
    </p>
  </section>

  <section class="grid3">
    <div class="card">
      <h2>Mission &amp; Vision</h2>
      <p><span data-src="sample">To be supplied by UASHMC.</span></p>
    </div>
    <div class="card">
      <h2>Leadership</h2>
      <p><span data-src="sample">Names, roles and photos to be supplied.</span></p>
    </div>
    <div class="card">
      <h2>Facilities</h2>
      <p>
        See our <a href="/services">services and specialties</a> for what we
        offer today. <span data-src="sample">A full facilities list to be supplied.</span>
      </p>
    </div>
  </section>

  <section class="accordion">
    <details>
      <summary>Hospital history</summary>
      <p><span data-src="sample">Our story, from planning to opening, will be published here.</span></p>
    </details>
    <details>
      <summary>Accreditations</summary>
      <p>
        <span data-src="sample"
          >Our DOH Licence to Operate number, service capability level and
          PhilHealth accreditation will be published here in full.</span
        >
      </p>
    </details>
    <details>
      <summary>Capabilities</summary>
      <p><span data-src="sample">A summary of our clinical and diagnostic capabilities will be published here.</span></p>
    </details>
  </section>
</Layout>

<style>
  .page-head,
  .grid3,
  .accordion {
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding: var(--space-8) var(--layout-gutter-mobile);
  }
  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--font-size-2xs);
    font-weight: 700;
    color: var(--color-brand-600);
    margin: 0 0 var(--space-2);
  }
  h1 {
    font-size: var(--font-size-3xl);
    margin-bottom: var(--space-4);
  }
  .lead {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    max-width: 60ch;
  }
  .grid3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    padding-top: 0;
  }
  @media (max-width: 820px) {
    .grid3 {
      grid-template-columns: 1fr;
    }
  }
  .card {
    background: var(--color-surface-raised);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    padding: var(--space-5);
    box-shadow: var(--elevation-1);
  }
  .card h2 {
    font-size: var(--font-size-lg);
    margin-bottom: var(--space-2);
  }
  .card p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .accordion {
    padding-top: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  details {
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    padding: var(--space-4) var(--space-5);
  }
  summary {
    cursor: pointer;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  details p {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
  }
</style>
