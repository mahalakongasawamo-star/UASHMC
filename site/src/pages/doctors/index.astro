---
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";

const doctors = await getCollection("doctors");

const SPECIALTIES = [
  { value: "Cardiology", label: "Cardiology", blurb: "The heart and blood vessels" },
  { value: "Internal Medicine", label: "Internal Medicine", blurb: "Adult general and specialty care" },
  { value: "Orthopedics", label: "Orthopedics", blurb: "Bones, joints and injuries" },
  { value: "Pediatrics", label: "Pediatrics", blurb: "Babies, children and teens" },
  { value: "Obstetrics & Gynaecology", label: "Obstetrics & Gynaecology", blurb: "Pregnancy and women's health" },
  { value: "ENT – Head & Neck Surgery", label: "ENT – Head & Neck Surgery", blurb: "Ear, nose, throat and sinuses" },
];
const DAYS = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];

function specCount(value: string) {
  return doctors.filter((d) => d.data.specialty === value).length;
}

// Field renderer matching the prototype's f(): verified when the doctor's own
// poster states it, otherwise a plain "to confirm" note. Never a plausible guess.
function field(d: (typeof doctors)[number]["data"], key: "specialty" | "note" | "clinicTime" | "room", missing: string) {
  const verified = d.verifiedFields.includes(key);
  const value = d[key];
  if (verified) return { text: value, verified: true };
  return { text: missing, verified: false };
}
---

<Layout
  title="Find a Doctor"
  description="Find a specialist at United Antipolo Specialists Hospital and Medical Center by name, specialty, clinic day or HMO."
>
  <section class="page-head">
    <p class="eyebrow">Find a Doctor</p>
    <h1>Find the right specialist for you</h1>
    <p class="lead">
      Browse by specialty, or filter by the day you're free and the HMO you
      carry.
    </p>
    <p class="note-slim">
      <strong>These are the doctors UASHMC has published so far.</strong>
      Fields their posts do not state are left visibly blank rather than
      filled in with a guess.
    </p>
  </section>

  <section class="clinics" aria-label="Filter by clinic">
    {
      SPECIALTIES.map((s) => (
        <button type="button" data-spec-filter={s.value}>
          <b>{s.label}</b>
          <span>{s.blurb}</span>
          <i class:list={["spec-count", { none: specCount(s.value) === 0 }]}>
            {specCount(s.value) === 0
              ? "Profiles coming"
              : `${specCount(s.value)} ${specCount(s.value) > 1 ? "doctors" : "doctor"}`}
          </i>
        </button>
      ))
    }
  </section>

  <section class="filters">
    <div class="field" style="flex:2">
      <label for="dq">Doctor's name</label>
      <input id="dq" type="search" placeholder="Type a surname" />
    </div>
    <div class="field">
      <label for="dspec">Specialty</label>
      <select id="dspec">
        <option value="">All specialties</option>
        {SPECIALTIES.map((s) => <option value={s.value}>{s.label}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="dday">Clinic day</label>
      <select id="dday">
        <option value="">Any day</option>
        {DAYS.map((d) => <option value={d}>{d}</option>)}
      </select>
    </div>
    <div class="field">
      <label for="dhmo">HMO</label>
      <select id="dhmo">
        <option value="">Any HMO</option>
        <option>MediCard</option>
        <option>Intellicare</option>
        <option>ValuCare</option>
      </select>
    </div>
  </section>

  <p id="dcount" class="dcount" aria-live="polite">
    {doctors.length} doctors · more profiles are being added
  </p>

  <section id="dgrid" class="dgrid">
    {
      doctors.map((d) => {
        const specialty = field(d.data, "specialty", "Specialty to confirm");
        const note = d.data.note ? field(d.data, "note", "") : null;
        const time = field(d.data, "clinicTime", "Clinic hours to confirm");
        const room = field(d.data, "room", "Room to confirm");
        const daysVerified = d.data.verifiedFields.includes("clinicDays");
        return (
          <article
            class="doc"
            data-name={d.data.name.toLowerCase()}
            data-specialty={d.data.specialty}
            data-days={JSON.stringify(d.data.clinicDays)}
            data-hmos={JSON.stringify(d.data.hmos)}
          >
            <a class="doc-link" href={`/doctors/${d.id}`}>
              <div class="doc-fig">
                <span class={`doc-ph p-${d.data.photoSlug}`} data-src="verified" role="img" aria-label={d.data.name} />
              </div>
              <div class="doc-b">
                <h2 data-src="verified">{d.data.name}</h2>
                <span class="doc-spec" data-src={specialty.verified ? "verified" : "sample"}>
                  {specialty.text}
                </span>
                {note && (
                  <p class="doc-note" data-src={note.verified ? "verified" : "sample"}>
                    {note.text}
                  </p>
                )}
                <div class="doc-meta">
                  <span data-src={daysVerified ? "verified" : "sample"}>
                    {daysVerified ? d.data.clinicDays.join(" · ") : "Clinic days to confirm"}
                  </span>
                  <span data-src={time.verified ? "verified" : "sample"}>{time.text}</span>
                  <span data-src={room.verified ? "verified" : "sample"}>{room.text}</span>
                </div>
                <div class="doc-hmo">
                  {d.data.hmos.length ? (
                    <span data-src="sample">{d.data.hmos.join(", ")}</span>
                  ) : (
                    <span data-src="sample">HMO coverage to confirm</span>
                  )}
                </div>
              </div>
            </a>
          </article>
        );
      })
    }
  </section>

  <div id="dempty" class="doc-empty" hidden>
    <p id="dempty-why"></p>
    <p>
      Call <a href="tel:+63282483460">02 8248 3460</a> or Viber
      <strong>0947 875 4949</strong> and we will book you with the right specialist.
    </p>
    <div class="doc-empty-a">
      <a class="btn btn-primary" href="tel:+63282483460">Call to book</a>
      <button class="btn btn-ghost" id="dclear" type="button">Clear the filters</button>
    </div>
  </div>
</Layout>

<script>
  // Client-side filter over the server-rendered, fully-crawlable doctor cards
  // above — filtering only ever hides/shows what's already real HTML, it never
  // generates the content. Ported from the prototype's renderDocs()/emptyDocs().
  const $ = (s: string, r: Document | Element = document) => r.querySelector(s);
  const $$ = (s: string, r: Document | Element = document) => Array.from(r.querySelectorAll(s));

  const dq = $("#dq") as HTMLInputElement;
  const dspec = $("#dspec") as HTMLSelectElement;
  const dday = $("#dday") as HTMLSelectElement;
  const dhmo = $("#dhmo") as HTMLSelectElement;
  const cards = $$(".doc") as HTMLElement[];
  const total = cards.length;

  function emptyReason(q: string, sp: string, dy: string, hm: string) {
    if (hm) return "We have not published which HMOs each doctor is accredited with yet — our HMO desk can tell you over the phone.";
    if (sp) return `We have not published a profile for <strong>${sp}</strong> yet, though the clinic is running.`;
    if (dy) return "We have not published every doctor's clinic days yet.";
    if (q) return "No doctor on our published list matches that name.";
    return "Nothing matches those filters yet.";
  }

  function render() {
    const q = dq.value.trim().toLowerCase();
    const sp = dspec.value;
    const dy = dday.value;
    const hm = dhmo.value;

    let shown = 0;
    cards.forEach((card) => {
      const days = JSON.parse(card.dataset.days || "[]") as string[];
      const hmos = JSON.parse(card.dataset.hmos || "[]") as string[];
      const match =
        (!q || (card.dataset.name || "").indexOf(q) > -1) &&
        (!sp || card.dataset.specialty === sp) &&
        (!dy || days.indexOf(dy) > -1) &&
        (!hm || hmos.indexOf(hm) > -1);
      card.hidden = !match;
      if (match) shown++;
    });

    ($("#dcount") as HTMLElement).textContent =
      (shown === total ? `${total} doctors` : `${shown} of ${total} doctors`) +
      " · more profiles are being added";

    const emptyEl = $("#dempty") as HTMLElement;
    emptyEl.hidden = shown !== 0;
    if (shown === 0) {
      ($("#dempty-why") as HTMLElement).innerHTML = emptyReason(q, sp, dy, hm);
    }
  }

  [dq, dspec, dday, dhmo].forEach((el) => el.addEventListener("input", render));

  $$("[data-spec-filter]").forEach((btn) => {
    btn.addEventListener("click", () => {
      dspec.value = (btn as HTMLElement).dataset.specFilter || "";
      render();
    });
  });

  ($("#dclear") as HTMLElement)?.addEventListener("click", () => {
    dq.value = "";
    dspec.value = "";
    dday.value = "";
    dhmo.value = "";
    render();
  });
</script>

<style>
  .page-head, .clinics, .filters, .dcount, .dgrid, .doc-empty {
    max-width: var(--layout-content-max);
    margin: 0 auto;
    padding-left: var(--layout-gutter-mobile);
    padding-right: var(--layout-gutter-mobile);
  }
  .page-head { padding-top: var(--space-8); }
  .eyebrow {
    text-transform: uppercase; letter-spacing: 0.08em; font-size: var(--font-size-2xs);
    font-weight: 700; color: var(--color-brand-600); margin: 0 0 var(--space-2);
  }
  h1 { font-size: var(--font-size-3xl); margin-bottom: var(--space-4); }
  .lead { font-size: var(--font-size-lg); color: var(--color-text-muted); max-width: 60ch; }
  .note-slim {
    font-size: var(--font-size-sm); color: var(--color-text-muted);
    background: var(--color-surface-sunken); border-radius: var(--radius-sm);
    padding: var(--space-3) var(--space-4); max-width: 70ch;
  }

  .clinics {
    padding-top: var(--space-6); padding-bottom: var(--space-6);
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-3);
  }
  @media (max-width: 820px) { .clinics { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .clinics { grid-template-columns: 1fr; } }
  .clinics button {
    text-align: left; background: var(--color-surface-raised);
    border: 1px solid var(--color-border-default); border-radius: var(--radius-md);
    padding: var(--space-4); cursor: pointer; font: inherit;
    display: flex; flex-direction: column; gap: var(--space-1);
  }
  .clinics button:hover { border-color: var(--color-brand-500); }
  .clinics b { color: var(--color-text-primary); }
  .clinics span { color: var(--color-text-muted); font-size: var(--font-size-sm); }
  .spec-count {
    font-style: normal; font-size: var(--font-size-xs); font-weight: 600;
    color: var(--color-brand-700); margin-top: var(--space-1);
  }
  .spec-count.none { color: var(--color-text-faint); }

  .filters {
    padding-bottom: var(--space-4);
    display: flex; flex-wrap: wrap; gap: var(--space-4);
  }
  .field { display: flex; flex-direction: column; gap: var(--space-1); flex: 1; min-width: 160px; }
  .field label { font-size: var(--font-size-sm); font-weight: 600; color: var(--color-text-body); }
  .field input, .field select {
    font: inherit; font-size: var(--font-size-base); padding: var(--space-3);
    border: 1px solid var(--color-border-default); border-radius: var(--radius-sm);
    min-height: 44px;
  }

  .dcount { color: var(--color-text-muted); font-size: var(--font-size-sm); padding-bottom: var(--space-4); }

  .dgrid {
    padding-bottom: var(--space-9);
    display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-4);
  }
  @media (max-width: 700px) { .dgrid { grid-template-columns: 1fr; } }
  .doc {
    border: 1px solid var(--color-border-default); border-radius: var(--radius-md);
    overflow: hidden; box-shadow: var(--elevation-1);
    transition: box-shadow var(--motion-base) var(--motion-ease);
  }
  .doc:hover { box-shadow: var(--elevation-2); }
  .doc-link { display: flex; gap: var(--space-4); text-decoration: none; color: inherit; padding: var(--space-4); }
  .doc-fig {
    flex: none; width: 88px; height: 88px; border-radius: var(--radius-md);
    overflow: hidden; background: var(--color-brand-100);
  }
  .doc-ph { display: block; width: 100%; height: 100%; background-size: cover; background-position: center 18%; }
  .doc-b { min-width: 0; }
  .doc-b h2 { font-size: var(--font-size-lg); margin-bottom: var(--space-1); }
  .doc-spec { display: block; color: var(--color-brand-700); font-weight: 600; font-size: var(--font-size-sm); margin-bottom: var(--space-2); }
  .doc-note { margin: 0 0 var(--space-2); color: var(--color-text-muted); font-size: var(--font-size-sm); }
  .doc-meta { display: flex; flex-direction: column; gap: var(--space-1); font-size: var(--font-size-sm); color: var(--color-text-muted); margin-bottom: var(--space-2); }
  .doc-hmo { font-size: var(--font-size-xs); color: var(--color-text-faint); }

  .doc-empty {
    padding-bottom: var(--space-9); text-align: center; color: var(--color-text-muted);
  }
  .doc-empty-a { display: flex; justify-content: center; gap: var(--space-3); margin-top: var(--space-4); }
</style>
