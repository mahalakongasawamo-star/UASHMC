---
import "../styles/tokens.css";
import "../styles/photos.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative URL. Defaults to the real building photo — see
   * docs/uashmc-design-guidelines.md §10.6: "falls back to a site default,
   * never a broken image." Per-entity images (a doctor's own photo, say) need
   * a real hosted file first — the current doctor photos are inlined as
   * base64, not servable as an image URL, so this stays the shared default
   * until that changes. */
  image?: string;
  /** Home is prepended automatically — pass the rest of the trail. Entity
   * pages (a doctor, a service) should pass their section index too, e.g.
   * [{ name: "Find a Doctor", url: "/doctors" }, { name: d.name, url: `/doctors/${d.id}` }].
   * Left empty, the page itself is the only crumb after Home. */
  breadcrumbs?: { name: string; url: string }[];
}

const { title, description, image = "/og-default.jpg", breadcrumbs = [] } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
const pageTitle = `${title} — UASHMC`;

// design guidelines §10.5: BreadcrumbList on every page, mechanical from the
// route tree. Home is the one crumb every page shares. A page that doesn't
// pass its own trail is one level deep, so the trail is just Home > itself;
// a page three levels deep (a doctor, a service) passes its own full trail,
// ending with itself, and none is added here on top of it.
const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const crumbs =
  breadcrumbs.length > 0
    ? [{ name: "Home", url: "/" }, ...breadcrumbs]
    : currentPath === "/"
      ? [{ name: "Home", url: "/" }]
      : [{ name: "Home", url: "/" }, { name: title, url: currentPath }];
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: new URL(c.url, Astro.site).toString(),
  })),
};

const NAV = [
  { href: "/doctors", label: "Doctors" },
  { href: "/services", label: "Services" },
  { href: "/patient-information", label: "Patient Information" },
  { href: "/about", label: "About UASHMC" },
  { href: "/news", label: "News" },
  { href: "/contact", label: "Contact" },
];

// Astro's static output serves each page as /about/index.html, so
// Astro.url.pathname is "/about/" — strip the trailing slash before comparing
// against NAV hrefs, or aria-current="page" silently never matches.
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en-PH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="United Antipolo Specialists Hospital and Medical Center" />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#01487C" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- Design guidelines §4.3: the emergency number lives in a utility strip above
         the header, present on every page at every breakpoint. It is not a nav item
         and must not be collapsed into the menu. -->
    <div class="emergency-strip">
      <a href="tel:+63282483460">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
        </svg>
        Emergency? Call 02 8248 3460
      </a>
    </div>

    <header class="site-header">
      <div class="site-header-in">
        <a class="brand" href="/">
          <span class="brand-name">UNITED ANTIPOLO</span>
          <span class="brand-sub">Specialists Hospital and Medical Center</span>
        </a>

        <button
          id="menu-toggle"
          class="menu-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-nav"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <span class="sr-only">Menu</span>
        </button>

        <nav id="primary-nav" aria-label="Primary">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={path === item.href ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <a class="btn btn-primary" href="/doctors">Find a doctor</a>
      </div>
    </header>

    <script>
      // Accessible disclosure menu for <900px — design guidelines §4.3: the menu
      // button carries aria-expanded/aria-controls; opening moves focus to the
      // first item; Escape closes and returns focus to the button.
      const toggle = document.getElementById("menu-toggle") as HTMLButtonElement;
      const nav = document.getElementById("primary-nav") as HTMLElement;

      function setOpen(open: boolean) {
        toggle.setAttribute("aria-expanded", String(open));
        nav.classList.toggle("open", open);
        document.body.classList.toggle("menu-open", open);
        if (open) {
          (nav.querySelector("a") as HTMLElement | null)?.focus();
        }
      }

      toggle.addEventListener("click", () => {
        setOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
          setOpen(false);
          toggle.focus();
        }
      });

      // A real navigation follows every link anyway (static pages, no SPA
      // routing here), but closing first avoids a flash of the open panel
      // during the page transition.
      nav.querySelectorAll("a").forEach((a) => {
        a.addEventListener("click", () => setOpen(false));
      });
    </script>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer-in">
        <div class="footer-brand">
          <p class="footer-name">UNITED ANTIPOLO</p>
          <p class="footer-sub">Specialists Hospital and Medical Center</p>
          <p class="footer-tag" data-src="verified">Excellence in Every Life We Touch.</p>
          <p data-src="verified">7 Marcos Highway, Barangay Mambugan<br />Antipolo City, Rizal</p>
        </div>

        <div class="footer-col">
          <h2>Patients</h2>
          <ul>
            <li><a href="/doctors">Find a doctor</a></li>
            <li><a href="/services">Services &amp; tests</a></li>
            <li><a href="/patient-information">HMOs &amp; PhilHealth</a></li>
            <li><a href="/patient-information">Admission</a></li>
            <li><a href="/faq">FAQ</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2>Hospital</h2>
          <ul>
            <li><a href="/about">About UASHMC</a></li>
            <li><a href="/news">News</a></li>
          </ul>
        </div>

        <div class="footer-col">
          <h2>Reach us</h2>
          <ul>
            <li><a href="tel:+63282483460" data-src="verified">02 8248 3460</a></li>
            <li><a href="tel:+639478754949" data-src="verified">Viber 0947 875 4949</a></li>
            <li>
              <a href="mailto:uashmc.customerrelations@gmail.com" data-src="verified"
                >uashmc.customerrelations@gmail.com</a
              >
            </li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
